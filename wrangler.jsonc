{
  "$schema": "worker/node_modules/wrangler/config-schema.json",
  "name": "extorsion",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "web/dist",
    "run_worker_first": ["/peru.pmtiles", "/data/*"],
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "extorsion-tiles" }],
}
